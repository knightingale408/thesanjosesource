{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://thesanjosesource.com/schemas/brief.schema.json", "title": "Brief front matter", "description": "The YAML front matter of content/brief-N.md. A brief cannot publish unless referenced source IDs and project IDs exist and required fields are valid.", "type": "object", "required": ["title", "slug", "published_at", "summary", "status"], "additionalProperties": true, "properties": {"title": {"type": "string", "minLength": 3}, "slug": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"}, "published_at": {"type": "string", "description": "RFC 3339 with timezone, e.g. 2026-11-11T06:00:00-08:00."}, "updated_at": {"type": "string"}, "summary": {"type": "string", "minLength": 10}, "categories": {"type": "array", "items": {"type": "string"}}, "funds": {"type": "array", "items": {"type": "string"}}, "project_ids": {"type": "array", "items": {"type": "string", "description": "Foreign keys into data/projects.csv."}}, "source_ids": {"type": "array", "items": {"type": "string", "description": "Foreign keys into data/sources.csv."}}, "status": {"type": "string", "enum": ["pitch", "researching", "draft", "source_review", "copy_review", "scheduled", "published", "corrected", "archived"]}}}