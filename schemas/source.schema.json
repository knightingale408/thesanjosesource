{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://thesanjosesource.com/schemas/source.schema.json", "title": "Source (provenance) record", "description": "One row of data/sources.csv. A source is a structured record, not a bare URL, so evidence survives the City replacing a PDF at the same address.", "type": "object", "required": ["source_id", "document_title", "source_document_url", "retrieved_at", "source_type"], "additionalProperties": false, "properties": {"source_id": {"type": "string", "pattern": "^sj-[a-z0-9-]+$"}, "document_title": {"type": "string", "minLength": 3}, "meeting_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"}, "agenda_item": {"type": "string"}, "page_start": {"type": "string", "pattern": "^[0-9]+$"}, "page_end": {"type": "string", "pattern": "^[0-9]+$"}, "source_document_url": {"type": "string", "pattern": "https://.+"}, "archived_document_url": {"type": "string", "description": "Immutable copy. Empty means not archived yet; validation warns."}, "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"}, "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Hash of the exact file used. Empty means not yet hashed; validation warns."}, "source_type": {"type": "string", "enum": ["council_packet", "council_report", "committee_report", "budget_document", "cip_report", "memorandum", "minutes", "public_notice", "news_release", "other"]}}}